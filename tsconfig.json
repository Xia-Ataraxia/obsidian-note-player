{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": true,
    "strict": false,
    "types": ["node"],
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "strictBindCallApply": true,
    "paths": {
      "@domain/*": [
        "./src/domain/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "lib": ["DOM", "ES2022"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
